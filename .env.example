# --- Database ---------------------------------------------------------------
# Postgres connection string (Supabase Postgres, Neon, RDS, local...).
# Leave empty to use the embedded PGlite database stored in ./.data/pglite
# (zero-setup local/demo mode; single process only, not for production).
DATABASE_URL=
# Optional: directory for the embedded PGlite database (default ./.data/pglite)
PGLITE_DIR=

# --- Auth ------------------------------------------------------------------
# Comma-separated emails that receive the admin role when they register/log in.
ADMIN_EMAILS=

# --- Demo data -------------------------------------------------------------
# "true" seeds clearly-labelled demo records (demo trails, demo parts with
# demo prices, demo workshops). They are flagged is_demo in the DB and shown
# with a "הדגמה" badge everywhere, including on maps.
SEED_DEMO_DATA=true

# --- Maps --------------------------------------------------------------------
# Raster tile URL template + attribution. Defaults to the OpenStreetMap
# standard tile server, which is fine for light interactive use under the OSMF
# Tile Usage Policy but must NOT be used for bulk/offline downloads.
NEXT_PUBLIC_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_TILE_ATTRIBUTION=© OpenStreetMap contributors

# --- Abuse protection ---------------------------------------------------------
# Max account registrations per client IP per 10 minutes (default 10).
REGISTER_RATE_LIMIT=10
